# Gemma hosted on Google AI (Gemini API). Create a key at https://aistudio.google.com/apikey
# inside the Google Cloud project that holds your credits, then paste it here.
GEMINI_API_KEY=
# SD_GEMINI_MODEL=gemma-3-27b-it        # run scripts/list_gemma_models.py to see what your key can use
# SD_LLM_BACKEND=auto                   # auto (gemini -> mlx -> ollama) | gemini | mlx | ollama
# SD_MLX_MODEL=mlx-community/gemma-4-e4b-it-4bit   # local Gemma 4 on Apple Silicon
# SD_OLLAMA_MODEL=gemma3:4b             # local fallback (ollama pull gemma3:4b)
# HF_TOKEN=                             # needed once to download google/embeddinggemma-300m (gated)
# GOOGLE_GENAI_USE_VERTEXAI=true      # only if your key is a Vertex AI key (check_gemini_key.py tells you)
